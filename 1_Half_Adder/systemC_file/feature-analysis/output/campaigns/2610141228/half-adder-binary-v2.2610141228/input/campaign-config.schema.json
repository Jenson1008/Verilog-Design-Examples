{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Deterministic campaign profile MVP v2/v3",
  "type": "object",
  "required": ["schema_version", "campaign_id", "scope", "source_root", "inputs", "source_files", "backend", "compiler", "compiler_version", "systemc_version", "build_command", "run_command", "executable_name", "test_id", "request_id", "experiment_id", "observation_id", "primary_feature_id", "stimulus_signals", "output_signals", "test_vectors", "log_file", "waveform_file", "log_columns", "coverage", "cycle_semantics", "evidence_rules", "timeout_seconds", "max_log_bytes", "max_artifact_bytes"],
  "properties": {
    "schema_version": {"enum": [2, 3]},
    "campaign_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$"},
    "scope": {
      "type": "object",
      "required": ["kind", "path", "parent_campaign_id"],
      "properties": {
        "kind": {"enum": ["ip", "subsystem", "soc"]},
        "path": {"type": "string", "minLength": 1},
        "parent_campaign_id": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$"}]}
      },
      "additionalProperties": false
    },
    "source_root": {"type": "string", "minLength": 1},
    "inputs": {
      "type": "object",
      "required": ["interface", "basic_description", "static_facts", "feature_proposal", "test_list"],
      "properties": {
        "interface": {"type": "string", "minLength": 1},
        "basic_description": {"type": "string", "minLength": 1},
        "static_facts": {"type": "string", "minLength": 1},
        "feature_proposal": {"type": "string", "minLength": 1},
        "test_list": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "source_files": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "backend": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["native", "wsl"]},
        "distribution": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "compiler": {"type": "string", "minLength": 1},
    "compiler_version": {"type": "string", "minLength": 1},
    "systemc_version": {"type": "string", "minLength": 1},
    "build_command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "run_command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "executable_name": {"type": "string", "minLength": 1},
    "test_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$"},
    "request_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$"},
    "experiment_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$"},
    "observation_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$"},
    "primary_feature_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$"},
    "stimulus_signals": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "output_signals": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "test_vectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["stimulus", "expected"],
        "properties": {
          "stimulus": {
            "type": "object",
            "additionalProperties": {"$ref": "#/$defs/testValue"}
          },
          "expected": {
            "type": "object",
            "additionalProperties": {"$ref": "#/$defs/testValue"}
          }
        },
        "additionalProperties": false
      }
    },
    "log_file": {"type": "string", "minLength": 1},
    "waveform_file": {"type": "string", "minLength": 1},
    "required_wave_signals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["port", "scope", "reference"],
        "properties": {
          "port": {"type": "string", "minLength": 1},
          "scope": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "reference": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "log_columns": {
      "type": "object",
      "required": ["inputs", "outputs", "status"],
      "properties": {
        "inputs": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}},
        "outputs": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}},
        "status": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "required": ["mode", "signals"],
      "properties": {
        "mode": {"enum": ["exhaustive", "directed"]},
        "signals": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "values": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/testValue"}
        },
        "domains": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"$ref": "#/$defs/testValue"}
          }
        }
      },
      "allOf": [
        {"if": {"properties": {"mode": {"const": "exhaustive"}}, "required": ["mode"]}, "then": {"anyOf": [{"required": ["values"]}, {"required": ["domains"]}]}}
      ],
      "additionalProperties": false
    },
    "cycle_semantics": {"type": "string", "minLength": 1},
    "trace_identity_protocol": {"const": "c2s.trace-identity.v1"},
    "cycle_semantics_version": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$"},
    "experiment_time_window": {"type": "string", "minLength": 1},
    "evidence_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["evidence_id", "rule_id", "feature_id", "statement", "preconditions", "required_observables", "source_fact_refs", "require_complete_domain"],
        "properties": {
          "evidence_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$"},
          "rule_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$"},
          "feature_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$"},
          "statement": {"type": "string", "minLength": 1},
          "preconditions": {"type": "array", "items": {"type": "string"}},
          "required_observables": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "source_fact_refs": {"type": "array", "items": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$"}},
          "require_complete_domain": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    },
    "timeout_seconds": {"type": "integer", "minimum": 1},
    "max_log_bytes": {"type": "integer", "minimum": 1},
    "max_artifact_bytes": {"type": "integer", "minimum": 1},
    "seed": {"type": "integer", "minimum": 0}
  },
  "$defs": {
    "testValue": {
      "anyOf": [
        {"type": "integer", "minimum": 0},
        {"enum": ["0", "1", "X", "Z", "x", "z"]}
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"schema_version": {"const": 3}},
        "required": ["schema_version"]
      },
      "then": {
        "required": ["trace_identity_protocol", "cycle_semantics_version"]
      }
    }
  ],
  "additionalProperties": false
}
