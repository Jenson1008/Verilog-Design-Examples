{
  "schema_version": "1.0",
  "top_module": "singleport_ram",
  "clocking_model": {
    "kind": "single_clock",
    "clocks": [{"port": "singleport_ram.clk", "active_edge": "rising"}],
    "resets": []
  },
  "ports": [
    {"name": "data_in", "canonical_path": "singleport_ram.data_in", "direction": "input", "systemc_type": "sc_dt::sc_lv<128>", "width": 128, "role": "写入存储阵列的数据"},
    {"name": "wr_en", "canonical_path": "singleport_ram.wr_en", "direction": "input", "systemc_type": "sc_dt::sc_logic", "width": 1, "role": "高电平时在时钟沿写 RAM"},
    {"name": "addr", "canonical_path": "singleport_ram.addr", "direction": "input", "systemc_type": "sc_dt::sc_lv<3>", "width": 3, "role": "选择 8 个 128 位字之一"},
    {"name": "clk", "canonical_path": "singleport_ram.clk", "direction": "input", "systemc_type": "sc_dt::sc_logic", "width": 1, "role": "写入及读地址寄存时钟"},
    {"name": "data_out", "canonical_path": "singleport_ram.data_out", "direction": "output", "systemc_type": "sc_dt::sc_lv<128>", "width": 128, "role": "由寄存读地址选择的异步读数据"}
  ],
  "declared_unknowns": [
    {"description": "RTL 未初始化 RAM 内容和 read_addr；转换保留四态未知值，测试先写入后读取。", "related_ports": ["singleport_ram.data_out"]},
    {"description": "RTL 的 data_out 是 ram_vector[read_addr] 连续读取；地址在 posedge 锁存，数据随后组合变化，读延迟由该 RTL 结构决定。"}
  ]
}
