  "cycle_semantics": "Cycle 0 is the first test vector after clk/reset/up_down have been initialized low. For each cycle, clk is held low while reset and up_down are driven, inputs settle for 1 ns, clk rises, and bin_count is sampled after a further 1 ns. The vector index is the cycle number; the CSV and VCD use nanoseconds. Only binary input values are requested.",
  "experiment_time_window": "Each vector is one positive-edge sample with 1 ns input setup and 1 ns post-edge settling before bin_count is read.",
  "evidence_rules": [
    {
      "evidence_id": "evidence.cntr3ud.bounded-step",
      "rule_id": "rule.cntr3ud.bounded-step",
      "feature_id": "feature.modulo-counter-step",
      "statement": "For this 20-vector directed sequence, reset=1 at a rising clock sample produces 000; otherwise up_down=0 advances the three-bit count modulo 8 and up_down=1 decrements it modulo 8. Every configured bin_count expectation matched.",
      "preconditions": [
        "The claim is bounded to the exact 20 binary vectors and cycle semantics recorded in this campaign.",
        "Cycle 0 samples reset=1 on a rising edge; no initial count value is assumed before that edge.",
        "No claim is made for X/Z inputs or other timing schedules."
      ],
      "required_observables": [
        "bin_count"
      ],
      "source_fact_refs": [
        "fact.counter.width",
        "fact.counter.clock-edge",
        "fact.counter.reset",
        "fact.counter.direction"
      ],
      "require_complete_domain": false
    }
  ],
  "timeout_seconds": 60,
  "max_log_bytes": 1048576,
  "max_artifact_bytes": 10485760,
  "seed": 0
