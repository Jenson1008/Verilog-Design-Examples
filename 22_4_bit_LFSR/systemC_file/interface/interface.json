    {"name": "clk", "canonical_path": "lfsr.clk", "direction": "input", "systemc_type": "sc_dt::sc_logic", "width": 1, "role": "状态移位时钟"},
    {"name": "data_out", "canonical_path": "lfsr.data_out", "direction": "output", "systemc_type": "sc_dt::sc_lv<4>", "width": 4, "role": "4 位 LFSR 当前状态"}
