{
  "schema_version": "1.0",
  "top_module": "lfsr",
  "clocking_model": {
    "kind": "single_clock",
    "clocks": [{"port": "lfsr.clk", "active_edge": "rising"}],
    "resets": [{"port": "lfsr.reset", "polarity": "active_high", "behavior": "synchronous", "sampling_edge": "rising", "asserted_meaning": "下一个时钟上升沿将状态种入 4'b0001。"}]
